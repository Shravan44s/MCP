# ============================================
# Notion MCP Task Orchestrator - Environment
# ============================================
# Copy this file to .env and fill in your values

# --- Notion ---
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# The ID of your Notion task database (32-char hex from the URL)
NOTION_DATABASE_ID=your_database_id_here

# --- GitHub ---
# Get from: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:user
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Public repo (owner/repo) used to publicly host rendered videos/images as
# throwaway Release assets before handing the URL to Instagram — Catbox/0x0.st
# block cloud IPs (Vercel, GitHub Actions), so this replaces them. In GitHub
# Actions this defaults to the repo the workflow runs in automatically.
GITHUB_MEDIA_REPO=your_username/your_repo

# --- VS Code ---
# Path to the VS Code CLI binary (default: "code")
VSCODE_CLI_PATH=code

# --- Telegram (Optional Notifications / Message Tool) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Chat ID from @userinfobot
TELEGRAM_CHAT_ID=xxxxxxxxxx

# --- Instagram (Meta Graph API) ---
# Access token with instagram_content_publish scope
INSTAGRAM_ACCESS_TOKEN=EAAB...
# Connected Instagram Business Account ID
INSTAGRAM_USER_ID=1784...

# --- Google Gemini (Free AI prompt enhancement) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# --- Email Reports (/email command) ---
# Your Gmail address used to send reports
GMAIL_USER=your_gmail_address@gmail.com
# Gmail App Password (NOT your regular password!)
# Enable 2FA first, then generate at:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Recipient email address for the dashboard report
EMAIL_TO=your_recipient_email@gmail.com

# --- Giphy (Free trending/search GIF source, already ships as .mp4) ---
# Get a free key from: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=your_giphy_api_key_here

# --- Imgflip (Optional — original captioned memes from popular templates) ---
# Free account: https://imgflip.com/signup
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# --- Cron Security ---
# Shared secret between /api/cron and the GitHub Actions workflow that calls it
CRON_SECRET=your_random_secret_here
# Your deployed Vercel URL (used by .github/workflows/general-tasks.yml)
VERCEL_URL=https://your-app.vercel.app
